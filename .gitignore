###############################################################################
# OS / Editor
###############################################################################
.DS_Store
*.swp
*.swo
*.tmp
*.temp
*.orig
*.log

###############################################################################
# Node / JS
###############################################################################
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing / Coverage
coverage/

# Bundle artifact
*.jsbundle

###############################################################################
# React Native / Metro / Watchman
###############################################################################
# Metro cache / health check
.metro-cache/
.metro-health-check*

# Watchman
.watchman-cookie

# React Native
.react-native/

###############################################################################
# Yarn (Berry) - keep the cache out, keep the important folders in
###############################################################################
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Yarn PnP
.pnp.*
.yarnrc.yml

###############################################################################
# Android / Gradle / IntelliJ / Android Studio
###############################################################################
# Gradle
.gradle/
**/.gradle/

# Build outputs
build/
**/build/
**/android/build/
**/android/app/build/

# Local Android config
local.properties

# Android Studio / IntelliJ
.idea/
*.iml
*.ipr
*.iws

# NDK / CMake
.cxx/
**/.cxx/

# Kotlin/Native
.kotlin/

# Heap dumps
*.hprof

# Signing keys (never commit)
*.keystore
*.jks
*.p12
*.p8
!debug.keystore

###############################################################################
# iOS / Xcode / CocoaPods / SwiftPM
###############################################################################
# Xcode build
DerivedData/
build/
**/ios/build/

# Xcode user data
xcuserdata/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.xccheckout
*.xcscmblueprint
*.moved-aside
*.xcuserstate
**/.xcode.env.local

# iOS archives
*.ipa
*.dSYM
*.hmap

# CocoaPods
Pods/

# Swift Package Manager
.swiftpm/
.build/

###############################################################################
# Ruby / Bundler (fastlane/cocoapods tooling)
###############################################################################
vendor/bundle/

###############################################################################
# Fastlane
###############################################################################
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots/
**/fastlane/test_output/

###############################################################################
# Secrets / Environment files
###############################################################################
.env
.env.*
*.env

###############################################################################
# Firebase (ignore by default to avoid secrets in repo)
# If your team commits these, remove these two lines.
###############################################################################
**/google-services.json
**/GoogleService-Info.plist

###############################################################################
# Misc (optional, but safe)
###############################################################################
# macOS Finder thumbnails
Icon?

*.class
target/

# dist/ — track metadata, ignore built binaries
dist/*.apk
dist/*.zip
dist/*.ipa

# Applitools applitoolsify binaries (auto-downloaded by build scripts)
libs/applitoolsify-*

# Icon generation marker (auto-created by build scripts)
.icon-generated

builds/
.claude/
.project*